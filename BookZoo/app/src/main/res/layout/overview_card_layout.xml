<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="7dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="400dp"
        android:layout_height="140dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="7dp"
        android:background="@drawable/overview_background">

        <ImageView
            android:id="@+id/cart_book_image"
            android:layout_width="90dp"
            android:layout_height="120dp"
            android:src="@drawable/img"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/cart_book_title"
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:text="Java Programming"
            android:textStyle="bold"
            app:layout_constraintStart_toEndOf="@+id/cart_book_image"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/cart_book_price_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Price: "
            android:textStyle="bold"
            app:layout_constraintStart_toEndOf="@+id/cart_book_image"
            app:layout_constraintTop_toBottomOf="@id/cart_book_title" />

        <TextView
            android:id="@+id/cart_book_price"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="$19.99"
            android:textStyle="bold"
            app:layout_constraintStart_toEndOf="@+id/cart_book_price_text"
            app:layout_constraintTop_toBottomOf="@id/cart_book_title" />

        <TextView
            android:id="@+id/cart_book_remove"
            android:layout_width="80dp"
            android:layout_height="29dp"
            android:layout_marginTop="17dp"
            android:background="@drawable/filter_background"
            android:clickable="true"
            android:drawableStart="@drawable/baseline_shopping_cart_24"
            android:focusable="true"
            android:foreground="?android:attr/selectableItemBackground"
            android:text="Remove"
            android:textSize="10dp"
            app:layout_constraintStart_toEndOf="@+id/cart_book_image"
            app:layout_constraintTop_toBottomOf="@+id/cart_book_price_text" />

        <TextView
            android:id="@+id/cart_book_increase"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:layout_marginEnd="15dp"
            android:text="+"
            android:textSize="20dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/cart_book_quantity"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="33dp"
            android:layout_marginEnd="10dp"
            android:text="1"
            android:textSize="15dp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@+id/cart_book_increase"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/cart_book_decrease"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:layout_marginEnd="10dp"
            android:text="-"
            android:textSize="30dp"
            app:layout_constraintEnd_toStartOf="@+id/cart_book_quantity"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/orderNow"
            android:layout_width="80dp"
            android:layout_height="29dp"
            android:layout_marginEnd="3dp"
            android:layout_marginBottom="22dp"
            android:background="@drawable/filter_background"
            android:backgroundTint="#015D52"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?android:attr/selectableItemBackground"
            android:gravity="center"
            android:text="Order Now"
            android:textColor="@color/white"
            android:textSize="10dp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</LinearLayout>